{
  "ConnectionStrings": {
    "AppIdentityDbContext": "User Id=postgres;Password=${IDENTITY_DB_POSTGRES_PASSWORD};Server=identitydb;Port=5432;Database=identitydb"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information"
    }
  },
  "Authentication": {
    "AccessTokenSecret": "",
    "RefreshTokenSecret": "",
    "AccessTokenExpirationMinutes": "30",
    "RefreshTokenExpirationMinutes": "43200",
    "Issuer": "https://localhost:8081",
    "Audience": "https://localhost:8081"
  },
  "MailSettings": {
    "DisplayName": "MyJwtAuthService",
    "From": "app@gmail.com",
    "Host": "papercut",
    "Port": "2525",
    "UserName": "user1",
    "Password": "user1",
    "IsAuthenticated": false
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:8888", "http://localhost:8889" ]
  },
  "OutboxBackgroundService": {
    "IntervalMiliseconds": 1100,
    "BatchSize": 50
  },
  
  "IdentityOptions": {
    "Password": {
      "RequireDigit": true,
      "RequiredLength": 10,
      "RequireNonAlphanumeric": true,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequiredUniqueChars": 2
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutTimeSpan": "00:15:00",
      "AllowedForNewUsers": true
    },
    "User": {
      "RequireUniqueEmail": true
    }
  }
  
}
